# Each line that does not start with # must be refused by event.Decode. The
# comment above it says why. A line is in the form the codec writes, so it
# is refused for what its comment says, unless the comment begins "form:".
# form: a field the model does not have
{"seq":1,"turn":0,"k":"prompt","pv":"typed","text":"hi","src":{"key":"a"},"extra":1}
# form: a field of the source the model does not have
{"seq":1,"turn":0,"k":"prompt","pv":"typed","text":"hi","src":{"key":"a","x":1}}
# form: trailing data after the object
{"seq":1,"turn":0,"k":"prompt","pv":"typed","text":"hi","src":{"key":"a"}} {}
# form: not an object
null
# seq 0
{"seq":0,"turn":0,"k":"prompt","pv":"typed","text":"hi","src":{"key":"a"}}
# a negative turn
{"seq":1,"turn":-1,"k":"prompt","pv":"typed","text":"hi","src":{"key":"a"}}
# an unknown kind
{"seq":1,"turn":0,"k":"note","pv":"typed","text":"hi","src":{"key":"a"}}
# an unknown author
{"seq":1,"turn":0,"k":"prompt","pv":"user","text":"hi","src":{"key":"a"}}
# no author
{"seq":1,"turn":0,"k":"prompt","pv":"","text":"hi","src":{"key":"a"}}
# no sameness key
{"seq":1,"turn":0,"k":"prompt","pv":"typed","text":"hi","src":{"h":true,"key":""}}
# a negative rule version
{"seq":1,"turn":0,"k":"prompt","pv":"typed","text":"hi","rv":-1,"src":{"key":"a"}}
# a copy of itself
{"seq":3,"turn":0,"k":"reply","pv":"agent","text":"hi","src":{"key":"a"},"copy":3}
# a copy of a later event
{"seq":3,"turn":0,"k":"reply","pv":"agent","text":"hi","src":{"key":"a"},"copy":4}
# a control without an operation
{"seq":1,"turn":0,"k":"control","pv":"eva","src":{"key":"a"}}
# an operation on an event that is not a control
{"seq":1,"turn":0,"k":"life","pv":"host","src":{"key":"a"},"op":"off"}
# an unknown operation
{"seq":1,"turn":0,"k":"control","pv":"eva","src":{"key":"a"},"op":"pause"}
# a reason on an event that is not a gap
{"seq":1,"turn":0,"k":"reply","pv":"agent","text":"hi","src":{"key":"a"},"why":"off_record"}
# a span past the end of the text
{"seq":1,"turn":0,"k":"reply","pv":"agent","text":"hi","red":[[0,3,"key","T1"]],"src":{"key":"a"}}
