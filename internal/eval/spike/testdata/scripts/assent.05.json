          },
          {
            "at": "2026-03-06T14:10:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Not this one, we tried something like it before and reverted it."
          },
          {
            "at": "2026-03-06T14:11:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "Shall I run logcheck --rotate-dry before each rotation?",
            "plants": [
              "f7"
            ]
          },
          {
            "at": "2026-03-06T14:12:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Yes, do that."
          },
          {
            "at": "2026-03-06T14:13:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "How about an alert when the logs-lag gauge climbs?",
