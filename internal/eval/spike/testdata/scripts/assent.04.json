          {
            "at": "2026-03-05T14:04:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Could be worth it later, not now."
          },
          {
            "at": "2026-03-05T14:05:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "Shall I run deploy preflight --with-rollback-plan before every release?",
            "plants": [
              "f3"
            ]
          },
          {
            "at": "2026-03-05T14:06:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "sure"
          },
          {
            "at": "2026-03-05T14:07:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "Should failed deploys page the owl-rota schedule?",
            "plants": [
              "f4"
