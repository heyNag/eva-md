        "turns": [
          {
            "at": "2026-03-07T14:00:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Let's go over the billing export today. Propose changes one at a time and I'll answer each."
          },
          {
            "at": "2026-03-07T14:01:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "Shall I move the billing export to the ledgerline job?",
            "plants": [
              "f1"
            ]
          },
          {
            "at": "2026-03-07T14:02:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Could be worth it later, not now."
          },
          {
            "at": "2026-03-07T14:03:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "I could write the export as parquet through the quarrywriter. Shall I?",
            "plants": [
              "f2"
            ]
          },
          {
            "at": "2026-03-07T14:04:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Nope."
          },
          {
            "at": "2026-03-07T14:05:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "I can round amounts with the half-even-plus rule, and I can also send the export to the tallyhouse mailbox. Shall I?",
            "plants": [
              "f3",
              "f4"
            ]
          },
          {
            "at": "2026-03-07T14:06:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "The first, no. The second, yes."
          },
          {
            "at": "2026-03-07T14:07:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "Should the export run in the owlshift window at night?",
            "plants": [
              "f5"
            ]
          },
          {
            "at": "2026-03-07T14:08:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "I'll check with the others first."
          },
          {
            "at": "2026-03-07T14:09:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "Shall I stamp each export with the inkseal mark?",
            "plants": [
              "f6"
            ]
          },
          {
            "at": "2026-03-07T14:10:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "no thanks, leave it as it is"
          },
          {
            "at": "2026-03-07T14:11:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "Before each month's close, shall I run export check --totals-only?",
            "plants": [
              "f7"
            ]
          },
          {
            "at": "2026-03-07T14:12:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "ok, go ahead"
          },
          {
            "at": "2026-03-07T14:13:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "How about keeping a copy in the vellum-archive?",
            "plants": [
              "f8"
            ]
          },
          {
            "at": "2026-03-07T14:14:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Perhaps. What would it cost us?"
          },
          {
            "at": "2026-03-07T14:15:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "Should we drop the old xlsx-legacy format?",
            "plants": [
              "f9"
            ]
          },
          {
            "at": "2026-03-07T14:16:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Yes, I see why, but no: keep what we have."
          },
          {
            "at": "2026-03-07T14:17:00+01:00",
            "author": "agent",
            "kind": "reply",
            "text": "I could split the export by region with the mapcut tool. Shall I?",
            "plants": [
              "f10"
            ]
          },
          {
            "at": "2026-03-07T14:18:00+01:00",
            "author": "typed",
            "kind": "prompt",
            "text": "Good question; let's decide after the release."
          }
        ]
      }
